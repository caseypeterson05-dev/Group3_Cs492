# Server
HOST=127.0.0.1
PORT=3000

# Checkout/cart
TAX_RATE=0.0725

# Delivery-radius prototype
DELIVERY_RADIUS_MILES=5
RESTAURANT_LATITUDE=39.7392
RESTAURANT_LONGITUDE=-104.9903

# Optional separate frontend dev origin.
# Leave blank when frontend is served by this Express app.
FRONTEND_ORIGIN=

# Optional HTTPS
HTTPS=false
SSL_KEY_FILE=
SSL_CERT_FILE=
TRUST_PROXY=0

# Stripe TEST MODE ONLY. Copy to .env and insert your own sandbox key.
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CHECKOUT_BASE_URL=http://127.0.0.1:3000
